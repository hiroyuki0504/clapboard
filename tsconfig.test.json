{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "jsx": "react-jsx",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "noEmit": false,
    "outDir": "out/test-build",
    "rootDir": ".",
    "target": "ES2022",
    "tsBuildInfoFile": "out/test-build/tsconfig.test.tsbuildinfo"
  },
  "include": [
    "tests/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "out/test-build"
  ]
}
