CLAPBOARD_API_BASE_URL=
CLAPBOARD_API_TOKEN=
CLAPBOARD_API_TIMEOUT_MS=5000

# セッション Cookie の HMAC-SHA256 署名鍵 (必須、推奨: openssl rand -hex 32)
# 未設定の場合、すべてのリクエストがログインページにリダイレクトされます。
CLAPBOARD_SESSION_SECRET=

# /api/files が公開するルートディレクトリの絶対パス。
# - production: 必須。未設定だと /api/files は 503 を返す。
#   (デフォルトでサーバホストの ~/Desktop を露出しないための安全策)
# - dev: 未設定なら `<cwd>/files` を使用。
# - production でもデモ用の `<cwd>/files` fallback を使う場合だけ
#   CLAPBOT_ALLOW_DEFAULT_FILES_ROOT=1 を明示してください。
# 例: CLAPBOT_FILES_ROOT=/var/clapboard/files
CLAPBOT_FILES_ROOT=
CLAPBOT_ALLOW_DEFAULT_FILES_ROOT=0
