CLAPBOARD_API_BASE_URL=
CLAPBOARD_API_TOKEN=
CLAPBOARD_API_TIMEOUT_MS=5000

# Access tokens (16文字以上のランダム文字列、推奨は `openssl rand -base64 32`)
# - admin (= 既存): 全 API/Page にアクセス可能。POST/PUT/DELETE/PATCH も許可。
# - viewer (任意): GET API + Page のみ閲覧可能。書き込み API は 403。
# 未設定のまま NODE_ENV=production で起動すると保護対象は 503 を返す。
CLAPBOARD_ACCESS_TOKEN=
CLAPBOARD_VIEWER_TOKEN=

# Rate limit ストア (任意): Vercel KV / Upstash Redis REST API。
# 未設定なら Edge memory に fallback。複数 Edge instance の集約には KV を推奨。
KV_REST_API_URL=
KV_REST_API_TOKEN=

# JWT 署名鍵 (任意、32文字以上): 設定すると login Cookie が
# HS256 署名 JWT になる。短期 access (15分) + 長期 refresh (7日) を発行し、
# /api/refresh で更新できる。未設定なら Cookie に生 token を保存する旧動作。
# 推奨: `openssl rand -base64 48`
CLAPBOARD_JWT_SECRET=
