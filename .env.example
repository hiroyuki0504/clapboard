CLAPBOARD_API_BASE_URL=
CLAPBOARD_API_TOKEN=
CLAPBOARD_API_TIMEOUT_MS=5000

# Access tokens / password (本番は16文字以上のランダム文字列を推奨)
# - local dev で未設定の場合だけ、ログインパスワード `password` が使えます。
# - admin (= 既存): 全 API/Page にアクセス可能。POST/PUT/DELETE/PATCH も許可。
# - viewer (任意): GET API + Page のみ閲覧可能。書き込み API は 403。
# 未設定のまま NODE_ENV=production で起動すると保護対象は 503 を返す。
CLAPBOARD_PASSWORD=
CLAPBOARD_ACCESS_TOKEN=
CLAPBOARD_VIEWER_TOKEN=

# Rate limit ストア (任意): Vercel KV / Upstash Redis REST API。
# 未設定なら Edge memory に fallback。複数 Edge instance の集約には KV を推奨。
KV_REST_API_URL=
KV_REST_API_TOKEN=

# JWT 署名鍵 (任意、32文字以上): 設定すると login Cookie が
# HS256 署名 JWT (role + exp 入り) になる。未設定なら Cookie に生 token を保存
# する旧動作（後方互換）。推奨: `openssl rand -base64 48`
CLAPBOARD_JWT_SECRET=

# /api/files が公開するルートディレクトリの絶対パス。
# - production: 必須。未設定だと /api/files は 503 を返す。
#   (デフォルトでサーバホストの ~/Desktop を露出しないための安全策)
# - dev: 未設定なら `<cwd>/files` を使用。
# 例: CLAPBOT_FILES_ROOT=/var/clapboard/files
CLAPBOT_FILES_ROOT=
